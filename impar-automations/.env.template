# Impar Automacoes - Configuracao
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env em repositorio publico!

# WhatsApp Integration (Webhook)
WHATSAPP_SEND_WEBHOOK_URL=https://seu-webhook-url.com
WHATSAPP_SEND_TOKEN=seu_token_whatsapp

# OpenAI API (para enhancements de titulos/descricoes)
OPENAI_API_KEY=sk-seu-api-key

# Facebook Integration (opcional)
FACEBOOK_TOKEN=seu_token_facebook
FACEBOOK_PAGE_ID=seu_page_id

# Agendamento (Data e Hora de inicio)
START_DATE=2026-07-21
START_TIME=09:00

# Configuracoes de Cadencia e Limites
# Marketplace: intervalo aleatorio humanizado
MARKETPLACE_INTERVAL_MIN=7
MARKETPLACE_INTERVAL_MAX=20

# Grupos: intervalo fixo entre posts
GROUPS_INTERVAL_MINUTES=3
GROUPS_POSTING_HOURS=11:30,17:00,21:30
GROUPS_PER_DAY_LIMIT=30

# Debug Mode (false em producao)
DEBUG=false
